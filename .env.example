# Copy to .env and adjust. Used by docker compose.

# Which NeMo checkpoint to serve (25 European languages, native word timestamps).
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3

# Audio longer than this many seconds switches to local attention (lower VRAM, up to ~3 h of audio).
# Lower it if a long file runs out of GPU memory.
PARAKEET_LOCAL_ATTN_AFTER=480

# Optional. When set, clients must send "Authorization: Bearer <API_KEY>".
API_KEY=

# Port on the host.
PORT=8000
